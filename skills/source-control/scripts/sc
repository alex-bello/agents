#!/usr/bin/env node

// skills/source-control/src/cli.ts
import { existsSync, readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import process from "node:process";
var EXIT = {
  usage: 2,
  detection: 3,
  unsupported: 4,
  missing: 5,
  auth: 6,
  native: 7,
  normalize: 8,
  version: 9
};
var COMMENT_PAGE_SIZE = 30;
var MAX_COMMENT_PAGES = 100;
var REPO_SEARCH_PAGE_SIZE = 100;
var MAX_REPO_SEARCH_PAGES = 100;
var LABEL_PAGE_SIZE = 100;
var MAX_LABEL_PAGES = 100;
var MIN_TEA_VERSION = "0.15.0";
var MIN_GH_VERSION = "2.57.0";
var SKIP_VERSION_CHECK_ENV = "SC_SKIP_VERSION_CHECK";
var VERSION = "0.14.1";
var sensitiveValues = new Set;
function rememberSensitiveValues() {
  for (const [name, value] of Object.entries(process.env)) {
    if (typeof value === "string" && value.length > 0 && /token|secret|password|credential|auth|private.?key/i.test(name)) {
      sensitiveValues.add(value);
    }
  }
}
rememberSensitiveValues();
function sanitizeText(value) {
  let result = value;
  for (const secret of sensitiveValues)
    result = result.split(secret).join("[redacted]");
  return result.replace(/(https?:\/\/)[^\s/@]+:[^\s/@]+@/gi, "$1[redacted]@").replace(/([?&](?:access_token|auth|key|password|secret|token)=)[^&#\s]*/gi, "$1[redacted]").replace(/\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})\b/g, "[redacted]").replace(/\b(Bearer\s+)[A-Za-z0-9._~+/-]+=*/gi, "$1[redacted]");
}
function sanitizeValue(value) {
  if (typeof value === "string")
    return sanitizeText(value);
  if (Array.isArray(value))
    return value.map(sanitizeValue);
  if (value && typeof value === "object") {
    return Object.fromEntries(Object.entries(value).map(([key, child]) => [key, sanitizeValue(child)]));
  }
  return value;
}
function fail(code, message) {
  process.stderr.write(`sc: ${sanitizeText(message)}
`);
  process.exit(code);
}
function emit(value) {
  process.stdout.write(`${JSON.stringify(sanitizeValue(value))}
`);
}
function executableExists(name) {
  const result = spawnSync("command", ["-v", name], {
    encoding: "utf8",
    shell: true,
    stdio: ["ignore", "ignore", "ignore"]
  });
  return result.status === 0;
}
function run(name, args, { allowFailure = false, skipVersionCheck = false } = {}) {
  if (!executableExists(name))
    fail(EXIT.missing, `required executable not found: ${name}`);
  if (!skipVersionCheck)
    requireToolVersion(name);
  const result = spawnSync(name, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  if (result.error && "code" in result.error && result.error.code === "ENOENT") {
    fail(EXIT.missing, `required executable not found: ${name}`);
  }
  if (result.status !== 0 && !allowFailure) {
    if (result.stderr)
      process.stderr.write(sanitizeText(result.stderr));
    fail(EXIT.native, `${name} command failed with exit code ${result.status ?? "unknown"}`);
  }
  return result;
}
var TOOL_REQUIREMENTS = {
  tea: {
    minimum: MIN_TEA_VERSION,
    pattern: /\bVersion:\s*(v?\d+\.\d+(?:\.\d+)?[0-9A-Za-z.+-]*)/i,
    symptom: "label list omits the org-level labels a repository inherits, so existing labels look missing",
    fix: "brew upgrade tea"
  },
  gh: {
    minimum: MIN_GH_VERSION,
    pattern: /\bgh version\s+(v?\d+\.\d+(?:\.\d+)?[0-9A-Za-z.+-]*)/i,
    symptom: "auth status --active (2.57.0) and pr checks --json (2.50.0) are unavailable, so those commands fail with unknown flag or field errors",
    fix: "brew upgrade gh (other platforms: https://github.com/cli/cli#installation)"
  }
};
var probedTools = new Map;
var verifiedTools = new Set;
function parseSemver(value) {
  const match = value.match(/^v?(\d+)\.(\d+)(?:\.(\d+))?(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$/);
  if (!match)
    return null;
  const core = [Number(match[1]), Number(match[2]), Number(match[3] ?? 0)];
  const prerelease = match[4] ?? null;
  return { core, prerelease, text: `${core.join(".")}${prerelease ? `-${prerelease}` : ""}` };
}
function compareSemver(left, right) {
  for (let index = 0;index < 3; index += 1) {
    if (left.core[index] !== right.core[index])
      return left.core[index] < right.core[index] ? -1 : 1;
  }
  if (left.prerelease === right.prerelease)
    return 0;
  if (left.prerelease === null)
    return 1;
  if (right.prerelease === null)
    return -1;
  return left.prerelease < right.prerelease ? -1 : 1;
}
function probeToolVersion(name) {
  const cached = probedTools.get(name);
  if (cached)
    return cached;
  const result = spawnSync(name, ["--version"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
  const output = (result.stdout ?? "").replace(/\x1b\[[0-9;?]*[ -/]*[@-~]/g, "");
  const parsed = result.status === 0 ? output.match(TOOL_REQUIREMENTS[name].pattern)?.[1] : undefined;
  const version = parsed ? parseSemver(parsed) : null;
  const probe = version ? { text: version.text, problem: null } : { text: null, problem: result.status === 0 ? `unrecognized "${name} --version" output` : `"${name} --version" failed with exit code ${result.status ?? "unknown"}` };
  probedTools.set(name, probe);
  return probe;
}
function toolVersionInfo(name) {
  const { minimum } = TOOL_REQUIREMENTS[name];
  const version = executableExists(name) ? probeToolVersion(name).text : null;
  const parsed = version ? parseSemver(version) : null;
  return { tool: name, version, minimum, supported: parsed ? compareSemver(parsed, parseSemver(minimum)) >= 0 : null };
}
function requireToolVersion(name) {
  if (name !== "tea" && name !== "gh")
    return;
  if (verifiedTools.has(name))
    return;
  verifiedTools.add(name);
  const { minimum, symptom, fix } = TOOL_REQUIREMENTS[name];
  if (process.env[SKIP_VERSION_CHECK_ENV] === "1") {
    process.stderr.write(`sc: warning: ${SKIP_VERSION_CHECK_ENV}=1 set; not verifying that ${name} is at least ${minimum}
`);
    return;
  }
  const probe = probeToolVersion(name);
  if (probe.text === null) {
    fail(EXIT.version, `could not determine the installed ${name} version (${probe.problem}); sc requires ${name} >= ${minimum}. Fix: install a standard ${name} release, or set ${SKIP_VERSION_CHECK_ENV}=1 to bypass this check`);
  }
  if (compareSemver(parseSemver(probe.text), parseSemver(minimum)) < 0) {
    fail(EXIT.version, `${name} ${probe.text} is older than the minimum supported version ${minimum}: ${symptom}. Fix: ${fix}, or set ${SKIP_VERSION_CHECK_ENV}=1 to bypass this check`);
  }
}
function runForgejoPullList(args) {
  const result = run("tea", args, { allowFailure: true });
  if (result.status === 0)
    return result.stdout;
  if (!/invalid field ['"]draft['"]/i.test(result.stderr)) {
    if (result.stderr)
      process.stderr.write(sanitizeText(result.stderr));
    fail(EXIT.native, `tea command failed with exit code ${result.status ?? "unknown"}`);
  }
  const fallbackArgs = [...args];
  const fieldsIndex = fallbackArgs.indexOf("--fields");
  const fields = fieldsIndex >= 0 ? fallbackArgs[fieldsIndex + 1]?.split(",") ?? [] : [];
  if (!fields.includes("draft")) {
    if (result.stderr)
      process.stderr.write(sanitizeText(result.stderr));
    fail(EXIT.native, `tea command failed with exit code ${result.status ?? "unknown"}`);
  }
  fallbackArgs[fieldsIndex + 1] = fields.filter((field) => field !== "draft").join(",");
  const fallback = run("tea", fallbackArgs, { allowFailure: true });
  if (fallback.status !== 0) {
    if (fallback.stderr)
      process.stderr.write(sanitizeText(fallback.stderr));
    fail(EXIT.native, `tea command failed with exit code ${fallback.status ?? "unknown"}`);
  }
  return fallback.stdout;
}
function parseJson(text, context) {
  try {
    const value = JSON.parse(text);
    return value;
  } catch {
    fail(EXIT.normalize, `could not normalize ${context} output as JSON`);
  }
}
function isJsonRecord(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}
function requireJsonRecord(value, context) {
  if (!isJsonRecord(value))
    fail(EXIT.normalize, `could not normalize ${context} output: expected a JSON object`);
  return value;
}
function requireJsonRecords(value, context) {
  if (!Array.isArray(value))
    fail(EXIT.normalize, `could not normalize ${context} output: expected a JSON array`);
  return value.map((item, index) => requireJsonRecord(item, `${context} item ${index + 1}`));
}
function parseJsonRecord(text, context) {
  return requireJsonRecord(parseJson(text, context), context);
}
function parseJsonRecords(text, context) {
  return requireJsonRecords(parseJson(text, context), context);
}
function commentNormalizationFailure(context, expectedShape) {
  fail(EXIT.normalize, `could not normalize ${context} output: expected ${expectedShape}; safe remediation: check the provider capability and fixture against the source-control command contract`);
}
function parseCommentList(text, context) {
  const trimmed = text.trim();
  if (trimmed === "" || /^no comments(?: found| available)?[.!]?$/i.test(trimmed))
    return [];
  let data;
  try {
    data = JSON.parse(trimmed);
  } catch {
    commentNormalizationFailure(context, "a JSON array or empty output");
  }
  if (!Array.isArray(data)) {
    commentNormalizationFailure(context, "a JSON array or empty output");
  }
  return data.map((item, index) => {
    if (!isJsonRecord(item))
      commentNormalizationFailure(context, `a JSON array of comment objects (item ${index + 1} was not an object)`);
    return item;
  });
}
function parseForgejoCommentPage(text, context) {
  const trimmed = text.trim();
  if (trimmed === "" || /^no comments(?: found| available)?[.!]?$/i.test(trimmed)) {
    return { comments: [], nextPage: null };
  }
  let data;
  try {
    data = JSON.parse(trimmed);
  } catch {
    commentNormalizationFailure(context, "a JSON array or empty output");
  }
  if (Array.isArray(data)) {
    const comments2 = data.map((item, index) => {
      if (!isJsonRecord(item))
        commentNormalizationFailure(context, `a JSON array of comment objects (item ${index + 1} was not an object)`);
      return item;
    });
    return {
      comments: comments2,
      nextPage: comments2.length === COMMENT_PAGE_SIZE ? "implicit" : null
    };
  }
  if (!isJsonRecord(data) || !Array.isArray(data.comments)) {
    commentNormalizationFailure(context, "a JSON array or empty output");
  }
  if (!isJsonRecord(data.pagination)) {
    commentNormalizationFailure(context, "a JSON array or an object with comments and pagination.next");
  }
  const nextPage = data.pagination.next;
  if (nextPage !== null && (typeof nextPage !== "number" || !Number.isInteger(nextPage) || nextPage < 1)) {
    commentNormalizationFailure(context, "pagination.next to be null or a positive integer page number");
  }
  const comments = data.comments.map((item, index) => {
    if (!isJsonRecord(item))
      commentNormalizationFailure(context, `a JSON array of comment objects (item ${index + 1} was not an object)`);
    return item;
  });
  return { comments, nextPage };
}
function parseForgejoCommentPages(number, scoped, operation) {
  const comments = [];
  const seenPages = new Set;
  let page = 1;
  for (let count = 0;count < MAX_COMMENT_PAGES; count += 1) {
    const pageReference = page;
    if (seenPages.has(pageReference))
      return comments;
    seenPages.add(pageReference);
    const nativeArgs = ["comments", "list", number, "--output", "json", "--limit", String(COMMENT_PAGE_SIZE), "--page", String(page), ...scoped];
    const parsed = parseForgejoCommentPage(run("tea", nativeArgs).stdout, operation);
    comments.push(...parsed.comments);
    if (parsed.nextPage === null)
      return comments;
    if (parsed.nextPage === "implicit") {
      page += 1;
      continue;
    }
    if (seenPages.has(parsed.nextPage))
      return comments;
    page = parsed.nextPage;
  }
  commentNormalizationFailure(operation, `pagination traversal to remain within ${MAX_COMMENT_PAGES} pages`);
}
function findForgejoRepository(owner, name, isPrivate, operation) {
  for (let page = 1;page <= MAX_REPO_SEARCH_PAGES; page += 1) {
    const output = run("tea", [
      "repos",
      "search",
      name,
      "--owner",
      owner,
      "--private",
      String(isPrivate),
      "--fields",
      "description,name,owner,url,permission,type",
      "--limit",
      String(REPO_SEARCH_PAGE_SIZE),
      "--page",
      String(page),
      "--output",
      "json"
    ]).stdout;
    const data = parseJsonRecords(output, operation);
    const item = data.find((candidate) => candidate.name === name && scalar(candidate.owner) === owner);
    if (item)
      return item;
    if (data.length < REPO_SEARCH_PAGE_SIZE)
      return null;
  }
  fail(EXIT.normalize, `could not normalize ${operation} output: repository search exceeded ${MAX_REPO_SEARCH_PAGES} pages`);
}
function listForgejoRepository(owner, name, operation) {
  for (let page = 1;page <= MAX_REPO_SEARCH_PAGES; page += 1) {
    const output = run("tea", [
      "repos",
      "list",
      "--owner",
      owner,
      "--limit",
      String(REPO_SEARCH_PAGE_SIZE),
      "--page",
      String(page),
      "--fields",
      "description,name,owner,url,permission,type",
      "--output",
      "json"
    ]).stdout;
    const data = parseJsonRecords(output, operation);
    const item = data.find((candidate) => candidate.name === name && scalar(candidate.owner) === owner);
    if (item)
      return item;
    if (data.length < REPO_SEARCH_PAGE_SIZE)
      return null;
  }
  fail(EXIT.normalize, `could not normalize ${operation} output: repository listing exceeded ${MAX_REPO_SEARCH_PAGES} pages`);
}
function parseGitHubCommentList(text, context) {
  let data;
  try {
    data = JSON.parse(text);
  } catch {
    commentNormalizationFailure(context, "a JSON object with a comments array");
  }
  if (!isJsonRecord(data) || !Array.isArray(data.comments)) {
    commentNormalizationFailure(context, "a JSON object with a comments array");
  }
  return data.comments.map((item, index) => {
    if (!isJsonRecord(item))
      commentNormalizationFailure(context, `a JSON array of comment objects (item ${index + 1} was not an object)`);
    return item;
  });
}
function scalar(value, fallback = null) {
  if (value === undefined || value === null)
    return fallback;
  if (isJsonRecord(value))
    return value.login ?? value.username ?? value.name ?? fallback;
  if (typeof value === "string" || typeof value === "number" || typeof value === "boolean")
    return value;
  return fallback;
}
function labels(value) {
  if (!Array.isArray(value)) {
    if (typeof value === "string")
      return value ? value.split(",").map((item) => item.trim()) : [];
    return [];
  }
  return value.map((item) => scalar(item)).filter(Boolean);
}
function normalizeItem(item) {
  return {
    number: Number(item.number ?? item.index),
    title: item.title ?? null,
    body: item.body ?? item.description ?? null,
    state: String(item.state ?? "").toLowerCase() || null,
    author: scalar(item.author ?? item.user),
    url: item.url ?? item.html_url ?? null,
    labels: labels(item.labels),
    createdAt: item.createdAt ?? item.created ?? item.created_at ?? null,
    updatedAt: item.updatedAt ?? item.updated ?? item.updated_at ?? null
  };
}
function normalizeComment(item) {
  return {
    id: item.id ?? null,
    author: scalar(item.author ?? item.user),
    body: item.body ?? item.content ?? null,
    url: item.url ?? item.html_url ?? null,
    createdAt: item.createdAt ?? item.created ?? item.created_at ?? null,
    updatedAt: item.updatedAt ?? item.updated ?? item.updated_at ?? null
  };
}
function normalizeLabel(item) {
  return {
    id: item.id ?? item.index ?? null,
    name: item.name ?? null,
    color: item.color ?? null,
    description: item.description ?? null
  };
}
function normalizeIssueLabelRefs(value, provider, number, repo) {
  if (!Array.isArray(value)) {
    fail(EXIT.normalize, `could not verify issue ${number} labels in repository "${repo}": expected a labels array`);
  }
  return value.map((item, index) => {
    if (!isJsonRecord(item)) {
      fail(EXIT.normalize, `could not verify issue ${number} labels in repository "${repo}": label ${index + 1} was not an object`);
    }
    const rawId = item.id ?? item.index;
    const id = rawId === undefined || rawId === null ? "" : String(rawId);
    const name = item.name;
    if (!id || typeof name !== "string" || !name) {
      fail(EXIT.normalize, `could not verify issue ${number} labels in repository "${repo}": label ${index + 1} lacked an ID or name`);
    }
    validateLabelId(provider, id);
    return { id, name };
  });
}
function requireRepository(repo) {
  if (!repo || !/^[^/]+\/[^/]+$/.test(repo))
    fail(EXIT.detection, "repository could not be determined; pass --repo OWNER/NAME");
  return repo;
}
function mutationRepoArgs(repo) {
  return ["--repo", repo];
}
function listAllLabels(provider, repo) {
  const scoped = mutationRepoArgs(repo);
  if (provider === "github") {
    const data = parseJsonRecords(run("gh", ["label", "list", "--limit", "1000", "--json", "id,name,color,description", ...scoped]).stdout, "label resolution");
    if (data.length >= 1000)
      fail(EXIT.normalize, `could not verify complete label set for repository ${repo}; GitHub label listing reached its 1000-item limit`);
    return data;
  }
  const labels2 = [];
  for (let page = 1;page <= MAX_LABEL_PAGES; page += 1) {
    const items = listForgejoLabels(scoped, LABEL_PAGE_SIZE, page, "label resolution");
    labels2.push(...items);
    if (items.length < LABEL_PAGE_SIZE)
      return labels2;
  }
  fail(EXIT.normalize, `could not verify complete label set for repository ${repo}; Forgejo label listing exceeded ${MAX_LABEL_PAGES} pages`);
}
function findLabelById(items, id, repo) {
  const matches = items.filter((item) => String(item.id ?? item.index ?? "") === id);
  if (matches.length === 0)
    fail(EXIT.missing, `label ID "${id}" was not found in repository "${repo}"`);
  if (matches.length !== 1)
    fail(EXIT.normalize, `label ID "${id}" is ambiguous in repository "${repo}"`);
  return matches[0];
}
function labelIds(items, context) {
  const ids = items.map((item) => String(item.id ?? item.index ?? ""));
  if (ids.some((id) => !id) || new Set(ids).size !== ids.length) {
    fail(EXIT.normalize, `could not verify ${context}: repository label IDs were missing or duplicated`);
  }
  return ids;
}
function requireUniqueLabelName(items, label, repo) {
  const name = String(label.name ?? "");
  if (!name)
    fail(EXIT.normalize, `label ID "${label.id}" has no name in repository "${repo}"`);
  const matches = items.filter((item) => item.name === name);
  if (matches.length !== 1 || String(matches[0]?.id ?? matches[0]?.index ?? "") !== String(label.id ?? label.index ?? "")) {
    fail(EXIT.usage, `label name "${name}" is ambiguous in repository "${repo}"; select a unique label name before mutating`);
  }
  return name;
}
function resolveUniqueNames(items, names, repo) {
  for (const name of names) {
    const matches = items.filter((item) => item.name === name);
    if (matches.length > 1)
      fail(EXIT.usage, `label name "${name}" is ambiguous in repository "${repo}"; use a unique label name`);
  }
}
function validateLabelId(provider, id) {
  const valid = provider === "forgejo" ? /^[1-9]\d*$/.test(id) : /^LA_[A-Za-z0-9_-]+$/.test(id);
  if (!valid)
    fail(EXIT.usage, `malformed ${provider} label ID "${id}"`);
}
function readIssue(provider, number, repo) {
  const scoped = mutationRepoArgs(repo);
  const normalize = (value) => {
    if (!isJsonRecord(value)) {
      fail(EXIT.normalize, `could not verify issue ${number} in repository "${repo}": provider returned a missing, malformed, or mismatched issue record`);
    }
    const issueNumber = value.number ?? value.index;
    if (String(issueNumber ?? "") !== number) {
      fail(EXIT.normalize, `could not verify issue ${number} in repository "${repo}": provider returned a missing, malformed, or mismatched issue record`);
    }
    return { labels: normalizeIssueLabelRefs(value.labels, provider, number, repo) };
  };
  if (provider === "github") {
    const item = parseJsonRecord(run("gh", ["issue", "view", number, "--json", "number,labels", ...scoped]).stdout, "issue label verification");
    return normalize(item);
  }
  const data = parseJson(run("tea", ["issues", number, "--fields", "index,labels", "--output", "json", ...scoped]).stdout, "issue label verification");
  if (Array.isArray(data) && data.length !== 1) {
    fail(EXIT.normalize, `could not verify issue ${number} in repository "${repo}": expected exactly one issue record`);
  }
  return normalize(Array.isArray(data) ? data[0] : data);
}
function normalizePullRequest(item) {
  return {
    ...normalizeItem(item),
    base: scalar(item.base ?? item.baseRefName),
    head: scalar(item.head ?? item.headRefName),
    draft: item.draft ?? item.isDraft ?? null,
    mergeable: item.mergeable ?? null
  };
}
function canonicalPullRequestUrl(repository, number, host) {
  if (!repository || !host)
    return null;
  return `https://${host}/${repository}/pulls/${number}`;
}
function parseGlobal(argv) {
  const options = { provider: "auto", repo: null, remote: "origin", limit: 30 };
  let index = 0;
  while (index < argv.length && argv[index].startsWith("--")) {
    const flag = argv[index++];
    if (flag === "--provider") {
      const provider = argv[index++];
      if (provider !== "auto" && provider !== "forgejo" && provider !== "github") {
        fail(EXIT.usage, "--provider must be auto, forgejo, or github");
      }
      options.provider = provider;
    } else if (flag === "--repo")
      options.repo = argv[index++];
    else if (flag === "--remote")
      options.remote = argv[index++];
    else if (flag === "--limit")
      options.limit = Number(argv[index++]);
    else
      fail(EXIT.usage, `unknown global option: ${flag}`);
  }
  if (!["auto", "forgejo", "github"].includes(options.provider)) {
    fail(EXIT.usage, "--provider must be auto, forgejo, or github");
  }
  if (!Number.isInteger(options.limit) || options.limit < 1 || options.limit > 100) {
    fail(EXIT.usage, "--limit must be an integer from 1 to 100");
  }
  return { options, rest: argv.slice(index) };
}
function parseOptions(args, definitions) {
  const positionals = [];
  const values = { _: positionals };
  for (const [name, type] of Object.entries(definitions))
    values[name] = type === "many" ? [] : type === "boolean" ? false : "";
  for (let index = 0;index < args.length; index += 1) {
    const value = args[index];
    if (!value.startsWith("--")) {
      positionals.push(value);
      continue;
    }
    const name = value.slice(2);
    const type = definitions[name];
    if (!type)
      fail(EXIT.usage, `unknown option: ${value}`);
    if (type === "boolean")
      values[name] = true;
    else {
      const next = args[++index];
      if (next === undefined)
        fail(EXIT.usage, `${value} requires a value`);
      if (type === "many") {
        const previous = values[name];
        if (!Array.isArray(previous))
          fail(EXIT.usage, `${value} cannot accept repeated values`);
        previous.push(next);
      } else
        values[name] = next;
    }
  }
  return values;
}
function remoteUrl(remote) {
  const result = run("git", ["remote", "get-url", remote], { allowFailure: true });
  return result.status === 0 ? result.stdout.trim() : "";
}
function hostFromRemote(url) {
  const ssh = url.match(/^[^@]+@([^:]+):/);
  if (ssh)
    return ssh[1].toLowerCase();
  try {
    return new URL(url).hostname.toLowerCase();
  } catch {
    return "";
  }
}
function repoFromRemote(url) {
  const match = url.match(/[:/]([^/:]+\/[^/]+?)(?:\.git)?$/);
  return match?.[1] ?? null;
}
function detectProvider(options) {
  if (options.provider !== "auto")
    return options.provider;
  const url = remoteUrl(options.remote);
  const host = hostFromRemote(url);
  if (host === "github.com")
    return "github";
  if (host && executableExists("tea")) {
    const result = run("tea", ["logins", "list", "--output", "json"], { allowFailure: true, skipVersionCheck: true });
    if (result.status === 0) {
      try {
        const loginData = parseJson(result.stdout, "tea login detection");
        const entries = Array.isArray(loginData) ? loginData : isJsonRecord(loginData) && Array.isArray(loginData.logins) ? loginData.logins : [];
        const hosts = entries.map((entry) => {
          if (!isJsonRecord(entry))
            return "";
          const candidate = String(entry.url ?? entry.host ?? entry.name ?? "");
          try {
            return new URL(candidate).hostname.toLowerCase();
          } catch {
            return String(candidate).toLowerCase();
          }
        });
        if (hosts.includes(host))
          return "forgejo";
      } catch {}
    }
  }
  fail(EXIT.detection, "could not detect provider; pass --provider forgejo or --provider github");
}
function repository(options) {
  return options.repo ?? repoFromRemote(remoteUrl(options.remote));
}
function repoArgs(provider, options) {
  if (!options.repo)
    return [];
  return provider === "github" ? ["--repo", options.repo] : ["--repo", options.repo];
}
function forgejoLabelRepoArgs(options) {
  const target = repository(options);
  return target ? ["--repo", target] : [];
}
function listForgejoLabels(scoped, limit, page = 1, operation = "label.list") {
  return parseJsonRecords(run("tea", ["labels", "list", "--limit", String(limit), "--page", String(page), "--output", "json", ...scoped]).stdout, operation);
}
function requireFile(path, flag) {
  if (!path)
    fail(EXIT.usage, `${flag} is required`);
  if (!existsSync(path))
    fail(EXIT.missing, `file not found: ${path}`);
  const contents = readFileSync(path, "utf8");
  if (contents.length > 0)
    sensitiveValues.add(contents);
  return contents;
}
function requireValue(value, description) {
  if (typeof value !== "string" || !value)
    fail(EXIT.usage, `${description} is required`);
  return value;
}
function urlFromOutput(text) {
  return text.match(/https?:\/\/[^\s\x00-\x1f\x7f]+/)?.[0] ?? null;
}
function plainTerminalText(text) {
  return text.replace(/\x1b\]8;;[^\x07\x1b]*(?:\x07|\x1b\\)/g, "").replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "");
}
function extractOutputUrls(text) {
  const urls = [];
  for (const candidateText of [text, plainTerminalText(text)]) {
    for (const match of candidateText.matchAll(/https?:\/\/[^\s\x00-\x1f\x7f]+/g)) {
      urls.push(match[0].replace(/[),.;:!?\]}>'"`]+$/, ""));
    }
  }
  return [...new Set(urls)];
}
function structuredOutputUrls(output) {
  const urls = [];
  let foundStructuredOutput = false;
  const structuredUrlFields = new Set(["url", "html_url", "web_url"]);
  function collect(value, key = null) {
    if (typeof value === "string" && key !== null && structuredUrlFields.has(key)) {
      urls.push(value);
      return;
    }
    if (Array.isArray(value)) {
      for (const item of value)
        collect(item);
      return;
    }
    if (isJsonRecord(value)) {
      for (const [childKey, childValue] of Object.entries(value))
        collect(childValue, childKey);
    }
  }
  for (const candidate of [output.trim(), ...output.split(/\r?\n/).map((line) => line.trim()).filter(Boolean)]) {
    try {
      const parsed = JSON.parse(candidate);
      if (parsed && typeof parsed === "object") {
        collect(parsed);
        foundStructuredOutput = true;
      }
    } catch {}
  }
  return { foundStructuredOutput, urls: [...new Set(urls)] };
}
function forgejoIssueIdentity(value, repository2, context) {
  if (!repository2 || repository2.split("/").length !== 2) {
    fail(EXIT.normalize, `could not normalize ${context}: repository is unavailable or malformed`);
  }
  let source;
  try {
    source = new URL(value);
  } catch {
    fail(EXIT.normalize, `could not normalize ${context}: created issue URL is malformed`);
  }
  const repositoryParts = repository2.split("/");
  const parts = source.pathname.split("/").filter(Boolean);
  const numberText = parts[repositoryParts.length + 1];
  const number = Number(numberText);
  const identifiesIssue = ["http:", "https:"].includes(source.protocol) && !source.username && !source.password && !source.search && !source.hash && parts.length === repositoryParts.length + 2 && parts.slice(0, repositoryParts.length).join("/") === repository2 && parts[repositoryParts.length] === "issues" && /^\d+$/.test(numberText ?? "") && Number.isSafeInteger(number) && number > 0;
  if (!identifiesIssue) {
    fail(EXIT.normalize, `could not normalize ${context}: URL does not identify an issue in repository ${repository2}`);
  }
  const url = `${source.origin}/${repository2}/issues/${number}`;
  if (source.href !== url) {
    fail(EXIT.normalize, `could not normalize ${context}: created issue URL is not canonical`);
  }
  return { number, url };
}
function forgejoCreatedIssueCandidate(output, repository2) {
  const lines = plainTerminalText(output).split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
  if (lines.length === 0) {
    fail(EXIT.normalize, "could not normalize Forgejo issue creation output: created issue URL is missing");
  }
  const finalLine = lines.at(-1);
  if (finalLine === undefined)
    fail(EXIT.normalize, "could not normalize Forgejo issue creation output: created issue URL is missing");
  const urls = [...finalLine.matchAll(/https?:\/\/[^\s\x00-\x1f\x7f]+/g)].map((match) => match[0]);
  if (urls.length === 0) {
    fail(EXIT.normalize, "could not normalize Forgejo issue creation output: created issue URL is missing from the final line");
  }
  if (urls.length !== 1) {
    fail(EXIT.normalize, `could not normalize Forgejo issue creation output: expected exactly one URL, found ${urls.length}`);
  }
  if (finalLine !== urls[0]) {
    fail(EXIT.normalize, "could not normalize Forgejo issue creation output: final line must contain only the created issue URL");
  }
  return forgejoIssueIdentity(urls[0], repository2, "Forgejo issue creation output");
}
function normalizeForgejoCreatedIssue(output, repository2, title, scoped) {
  const candidate = forgejoCreatedIssueCandidate(output, repository2);
  const verification = parseJson(run("tea", ["issues", String(candidate.number), "--fields", "index,title,url", "--output", "json", ...scoped]).stdout, "issue.create verification");
  const items = Array.isArray(verification) ? requireJsonRecords(verification, "issue.create verification") : [requireJsonRecord(verification, "issue.create verification")];
  if (items.length !== 1) {
    fail(EXIT.normalize, `could not verify Forgejo issue creation: expected exactly one structured issue, found ${items.length}`);
  }
  const item = items[0];
  const verifiedNumber = Number(item.index ?? item.number);
  if (!Number.isSafeInteger(verifiedNumber) || verifiedNumber < 1 || verifiedNumber !== candidate.number) {
    fail(EXIT.normalize, "could not verify Forgejo issue creation: structured issue number does not match creation output");
  }
  if (item.title !== title) {
    fail(EXIT.normalize, "could not verify Forgejo issue creation: structured issue title does not match the requested title");
  }
  if (typeof item.url !== "string") {
    fail(EXIT.normalize, "could not verify Forgejo issue creation: structured issue URL is missing or malformed");
  }
  const verified = forgejoIssueIdentity(item.url, repository2, "Forgejo issue creation verification");
  if (verified.number !== candidate.number || verified.url !== candidate.url) {
    fail(EXIT.normalize, "could not verify Forgejo issue creation: structured issue URL does not match creation output");
  }
  return {
    provider: "forgejo",
    operation: "issue.create",
    repository: repository2,
    number: verified.number,
    success: true,
    url: verified.url
  };
}
function pullRequestIdentity(value, provider, repository2, expectedHost) {
  if (!repository2)
    return null;
  let source;
  try {
    source = new URL(value);
  } catch {
    return null;
  }
  const parts = source.pathname.replace(/\/+$/, "").split("/").filter(Boolean);
  const repositoryParts = repository2.split("/");
  const kind = parts[repositoryParts.length];
  const numberText = parts[repositoryParts.length + 1];
  const allowedKinds = provider === "github" ? ["pull"] : ["pull", "pulls"];
  if (!["http:", "https:"].includes(source.protocol) || expectedHost && source.hostname.toLowerCase() !== expectedHost.toLowerCase() || source.username || source.password || source.search || source.hash || parts.length !== repositoryParts.length + 2 || parts.slice(0, repositoryParts.length).join("/") !== repository2 || !allowedKinds.includes(kind) || !/^\d+$/.test(numberText ?? "")) {
    return null;
  }
  const number = Number(numberText);
  if (!Number.isSafeInteger(number) || number < 1)
    return null;
  return {
    number,
    url: `https://${source.host}/${repository2}/pulls/${number}`
  };
}
function normalizeCreatedPullRequest(output, provider, repository2, parsed, expectedHost = null) {
  const structured = structuredOutputUrls(output);
  const urls = structured.foundStructuredOutput ? structured.urls : extractOutputUrls(output);
  const identities = urls.map((url2) => pullRequestIdentity(url2, provider, repository2, expectedHost)).filter((candidate2) => candidate2 !== null);
  const candidates = [...new Map(identities.map((candidate2) => [candidate2.url, candidate2])).values()];
  if (candidates.length === 0) {
    fail(EXIT.normalize, `could not normalize pull-request creation output: no canonical pull-request URL found for repository ${repository2}`);
  }
  if (candidates.length > 1) {
    fail(EXIT.normalize, `could not normalize pull-request creation output: ambiguous canonical pull-request URLs: ${candidates.map((candidate2) => candidate2.url).join(", ")}`);
  }
  const candidate = candidates[0];
  if (!candidate)
    fail(EXIT.normalize, "could not normalize pull-request creation output: no canonical pull-request URL found");
  const { number, url } = candidate;
  return {
    provider,
    operation: "pr.create",
    repository: repository2,
    success: true,
    number,
    url,
    title: parsed.title,
    base: parsed.base,
    head: parsed.head,
    state: "open"
  };
}
function github(operation, args, options) {
  const repo = repository(options);
  const scoped = repoArgs("github", options);
  if (operation === "label.list") {
    const data = parseJsonRecords(run("gh", ["label", "list", "--limit", String(options.limit), "--json", "id,name,color,description", ...scoped]).stdout, operation);
    emit({ provider: "github", operation, repository: repo, items: data.map(normalizeLabel) });
    return;
  }
  if (operation === "label.delete") {
    const parsed = parseOptions(args, { id: "value" });
    const id = requireValue(parsed.id, "--id");
    validateLabelId("github", id);
    const targetRepo = requireRepository(repo);
    const before = listAllLabels("github", targetRepo);
    const label = findLabelById(before, id, targetRepo);
    requireUniqueLabelName(before, label, targetRepo);
    const current = listAllLabels("github", targetRepo);
    const currentLabel = findLabelById(current, id, targetRepo);
    const name = requireUniqueLabelName(current, currentLabel, targetRepo);
    run("gh", ["label", "delete", name, "--yes", ...mutationRepoArgs(targetRepo)]);
    const beforeIds = labelIds(before, `label deletion in repository "${targetRepo}"`);
    const afterIds = labelIds(listAllLabels("github", targetRepo), `label deletion in repository "${targetRepo}"`);
    const expected = beforeIds.filter((item) => item !== id).sort();
    if (afterIds.includes(id) || JSON.stringify([...afterIds].sort()) !== JSON.stringify(expected)) {
      fail(EXIT.normalize, `could not verify that only label ID "${id}" was deleted in repository "${targetRepo}"`);
    }
    emit({ provider: "github", repository: targetRepo, operation, label_id: id, success: true });
    return;
  }
  if (operation === "label.create") {
    const parsed = parseOptions(args, { name: "value", color: "value", description: "value" });
    const name = requireValue(parsed.name, "--name");
    const native = ["label", "create", name, ...scoped];
    if (parsed.color)
      native.push("--color", parsed.color);
    if (parsed.description)
      native.push("--description", parsed.description);
    const result = run("gh", native);
    emit({ provider: "github", operation, repository: repo, name, success: true, output: result.stdout.trim() });
    return;
  }
  if (operation === "auth.status") {
    const result = run("gh", ["auth", "status", "--active"], { allowFailure: true });
    emit({ provider: "github", operation, repository: repo, authenticated: result.status === 0, tool: toolVersionInfo("gh") });
    return;
  }
  if (operation === "repo.view") {
    const target = options.repo ? [options.repo] : [];
    const data = parseJsonRecord(run("gh", ["repo", "view", ...target, "--json", "nameWithOwner,description,url,visibility,isFork,defaultBranchRef"]).stdout, operation);
    emit({ provider: "github", operation, repository: data.nameWithOwner ?? repo, item: {
      name: data.nameWithOwner ?? repo,
      description: data.description ?? null,
      url: data.url ?? null,
      visibility: typeof data.visibility === "string" ? data.visibility.toLowerCase() : null,
      fork: Boolean(data.isFork),
      defaultBranch: isJsonRecord(data.defaultBranchRef) ? data.defaultBranchRef.name ?? null : null
    } });
    return;
  }
  if (operation === "issue.list") {
    const parsed = parseOptions(args, { state: "value", label: "many" });
    const native = [
      "issue",
      "list",
      "--limit",
      String(options.limit),
      "--state",
      parsed.state || "open",
      "--json",
      "number,title,body,state,author,url,labels,createdAt,updatedAt",
      ...scoped
    ];
    for (const label of parsed.label)
      native.push("--label", label);
    const data = parseJsonRecords(run("gh", native).stdout, operation);
    emit({ provider: "github", operation, repository: repo, items: data.map(normalizeItem) });
    return;
  }
  if (operation === "issue.view" || operation === "issue.comments") {
    const number = requireValue(args[0], "issue number");
    const fields = operation.endsWith("comments") ? "number,comments" : "number,title,body,state,author,url,labels,createdAt,updatedAt";
    if (operation.endsWith("comments")) {
      const comments = parseGitHubCommentList(run("gh", ["issue", "view", number, "--json", fields, ...scoped]).stdout, operation);
      emit({ provider: "github", operation, repository: repo, number: Number(number), items: comments.map(normalizeComment) });
    } else {
      const data = parseJsonRecord(run("gh", ["issue", "view", number, "--json", fields, ...scoped]).stdout, operation);
      emit({ provider: "github", operation, repository: repo, item: normalizeItem(data) });
    }
    return;
  }
  if (operation === "issue.create") {
    const parsed = parseOptions(args, { title: "value", "body-file": "value", label: "many" });
    const title = requireValue(parsed.title, "--title");
    const bodyFile = requireValue(parsed["body-file"], "--body-file");
    requireFile(bodyFile, "--body-file");
    const native = ["issue", "create", "--title", title, "--body-file", bodyFile, ...scoped];
    for (const label of parsed.label)
      native.push("--label", label);
    const result = run("gh", native);
    emit({ provider: "github", operation, repository: repo, success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.edit") {
    const parsed = parseOptions(args, { "body-file": "value", "add-label": "many", "remove-label": "many" });
    const number = requireValue(parsed._[0], "issue number");
    const native = ["issue", "edit", number, ...scoped];
    if (parsed["body-file"]) {
      requireFile(parsed["body-file"], "--body-file");
      native.push("--body-file", parsed["body-file"]);
    }
    for (const label of parsed["add-label"])
      native.push("--add-label", label);
    for (const label of parsed["remove-label"])
      native.push("--remove-label", label);
    if (!parsed["body-file"] && !parsed["add-label"].length && !parsed["remove-label"].length) {
      fail(EXIT.usage, "issue edit requires --body-file, --add-label, or --remove-label");
    }
    if (parsed["add-label"].length || parsed["remove-label"].length) {
      const targetRepo = requireRepository(repo);
      resolveUniqueNames(listAllLabels("github", targetRepo), [...parsed["add-label"], ...parsed["remove-label"]], targetRepo);
      resolveUniqueNames(listAllLabels("github", targetRepo), [...parsed["add-label"], ...parsed["remove-label"]], targetRepo);
      if (!options.repo)
        native.push(...mutationRepoArgs(targetRepo));
    }
    const result = run("gh", native);
    emit({ provider: "github", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.remove-label") {
    const parsed = parseOptions(args, { id: "value" });
    const number = requireValue(parsed._[0], "issue number");
    if (!/^\d+$/.test(number) || Number(number) < 1)
      fail(EXIT.usage, `invalid issue number "${number}"`);
    const id = requireValue(parsed.id, "--id");
    validateLabelId("github", id);
    const targetRepo = requireRepository(repo);
    const allLabels = listAllLabels("github", targetRepo);
    const label = findLabelById(allLabels, id, targetRepo);
    const name = requireUniqueLabelName(allLabels, label, targetRepo);
    const before = readIssue("github", number, targetRepo).labels;
    if (!before.some((item) => String(item.id) === id))
      fail(EXIT.missing, `label ID "${id}" is not attached to issue ${number} in repository "${targetRepo}"`);
    const current = listAllLabels("github", targetRepo);
    const currentLabel = findLabelById(current, id, targetRepo);
    const currentName = requireUniqueLabelName(current, currentLabel, targetRepo);
    if (currentName !== name)
      fail(EXIT.normalize, `label ID "${id}" changed identity before removal in repository "${targetRepo}"`);
    run("gh", ["issue", "edit", number, "--remove-label", currentName, ...mutationRepoArgs(targetRepo)]);
    const afterLabels = listAllLabels("github", targetRepo);
    const afterTarget = findLabelById(afterLabels, id, targetRepo);
    if (requireUniqueLabelName(afterLabels, afterTarget, targetRepo) !== name) {
      fail(EXIT.normalize, `label ID "${id}" no longer uniquely maps to name "${name}" after issue removal in repository "${targetRepo}"`);
    }
    const after = readIssue("github", number, targetRepo).labels;
    const beforeIds = before.map((item) => String(item.id ?? ""));
    const afterIds = after.map((item) => String(item.id ?? ""));
    const expected = beforeIds.filter((item) => item !== id).sort();
    if (beforeIds.some((item) => !item) || afterIds.some((item) => !item) || afterIds.includes(id) || JSON.stringify([...afterIds].sort()) !== JSON.stringify(expected)) {
      fail(EXIT.normalize, `could not verify that only label ID "${id}" was removed from issue ${number} in repository "${targetRepo}"`);
    }
    emit({ provider: "github", repository: targetRepo, operation, issue_number: Number(number), label_id: id, success: true });
    return;
  }
  if (operation === "pr.edit") {
    const parsed = parseOptions(args, { "body-file": "value" });
    const number = requireValue(parsed._[0], "pull request number");
    requireFile(parsed["body-file"], "--body-file");
    const result = run("gh", ["pr", "edit", number, "--body-file", parsed["body-file"], ...scoped]);
    emit({ provider: "github", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.close") {
    const number = requireValue(args[0], "issue number");
    const result = run("gh", ["issue", "close", number, ...scoped]);
    emit({ provider: "github", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.comment" || operation === "pr.comment") {
    const parsed = parseOptions(args, { "body-file": "value" });
    const number = requireValue(parsed._[0], `${operation.split(".")[0]} number`);
    requireFile(parsed["body-file"], "--body-file");
    const resource = operation.split(".")[0];
    const result = run("gh", [resource, "comment", number, "--body-file", parsed["body-file"], ...scoped]);
    emit({ provider: "github", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "pr.list") {
    const parsed = parseOptions(args, { state: "value" });
    const data = parseJsonRecords(run("gh", [
      "pr",
      "list",
      "--limit",
      String(options.limit),
      "--state",
      parsed.state || "open",
      "--json",
      "number,title,body,state,author,url,labels,createdAt,updatedAt,baseRefName,headRefName,isDraft,mergeable",
      ...scoped
    ]).stdout, operation);
    emit({ provider: "github", operation, repository: repo, items: data.map(normalizePullRequest) });
    return;
  }
  if (["pr.view", "pr.comments"].includes(operation)) {
    const number = requireValue(args[0], "pull request number");
    const fields = operation.endsWith("comments") ? "number,comments" : "number,title,body,state,author,url,labels,createdAt,updatedAt,baseRefName,headRefName,isDraft,mergeable";
    if (operation === "pr.comments") {
      const comments = parseGitHubCommentList(run("gh", ["pr", "view", number, "--json", fields, ...scoped]).stdout, operation);
      emit({ provider: "github", operation, repository: repo, number: Number(number), items: comments.map(normalizeComment) });
    } else {
      const data = parseJsonRecord(run("gh", ["pr", "view", number, "--json", fields, ...scoped]).stdout, operation);
      emit({ provider: "github", operation, repository: repo, item: normalizePullRequest(data) });
    }
    return;
  }
  if (operation === "pr.diff") {
    const number = requireValue(args[0], "pull request number");
    const result = run("gh", ["pr", "diff", number, ...scoped]);
    emit({ provider: "github", operation, repository: repo, number: Number(number), diff: result.stdout });
    return;
  }
  if (operation === "pr.checks") {
    const number = requireValue(args[0], "pull request number");
    const result = run("gh", ["pr", "checks", number, "--json", "name,state,bucket,link,workflow", ...scoped], { allowFailure: true });
    if (result.status !== 0 && result.status !== 8) {
      if (result.stderr)
        process.stderr.write(sanitizeText(result.stderr));
      fail(EXIT.native, `gh command failed with exit code ${result.status}`);
    }
    const data = parseJsonRecords(result.stdout, operation);
    emit({ provider: "github", operation, repository: repo, number: Number(number), items: data.map((item) => ({
      name: item.name ?? null,
      state: item.bucket ?? item.state ?? null,
      url: item.link ?? null,
      workflow: item.workflow ?? null
    })) });
    return;
  }
  if (operation === "pr.create") {
    const parsed = parseOptions(args, { base: "value", head: "value", title: "value", "body-file": "value", draft: "boolean", label: "many" });
    const base = requireValue(parsed.base, "--base");
    const head = requireValue(parsed.head, "--head");
    const title = requireValue(parsed.title, "--title");
    requireFile(parsed["body-file"], "--body-file");
    const native = [
      "pr",
      "create",
      "--base",
      base,
      "--head",
      head,
      "--title",
      title,
      "--body-file",
      parsed["body-file"],
      ...scoped
    ];
    if (parsed.draft)
      native.push("--draft");
    for (const label of parsed.label)
      native.push("--label", label);
    const result = run("gh", native);
    emit(normalizeCreatedPullRequest(result.stdout, "github", repo, parsed, hostFromRemote(remoteUrl(options.remote))));
    return;
  }
  if (operation === "pr.ready") {
    const number = requireValue(args[0], "pull request number");
    const result = run("gh", ["pr", "ready", number, ...scoped]);
    emit({
      provider: "github",
      operation,
      repository: repo,
      number: Number(number),
      success: true,
      url: urlFromOutput(result.stdout) ?? canonicalPullRequestUrl(repo, Number(number), hostFromRemote(remoteUrl(options.remote)))
    });
    return;
  }
  if (operation === "pr.checkout") {
    const number = requireValue(args[0], "pull request number");
    run("gh", ["pr", "checkout", number, ...scoped]);
    emit({ provider: "github", operation, repository: repo, number: Number(number), success: true });
    return;
  }
  fail(EXIT.unsupported, `operation is unsupported for github: ${operation}`);
}
function forgejo(operation, args, options) {
  const repo = repository(options);
  const scoped = repoArgs("forgejo", options);
  const labelScoped = forgejoLabelRepoArgs(options);
  if (operation === "label.list") {
    const data = listForgejoLabels(labelScoped, options.limit, 1, operation);
    emit({ provider: "forgejo", operation, repository: repo, items: data.map(normalizeLabel) });
    return;
  }
  if (operation === "label.delete") {
    const parsed = parseOptions(args, { id: "value" });
    const id = requireValue(parsed.id, "--id");
    validateLabelId("forgejo", id);
    const targetRepo = requireRepository(repo);
    const before = listAllLabels("forgejo", targetRepo);
    findLabelById(before, id, targetRepo);
    findLabelById(listAllLabels("forgejo", targetRepo), id, targetRepo);
    run("tea", ["labels", "delete", "--id", id, ...mutationRepoArgs(targetRepo)]);
    const beforeIds = labelIds(before, `label deletion in repository "${targetRepo}"`);
    const afterIds = labelIds(listAllLabels("forgejo", targetRepo), `label deletion in repository "${targetRepo}"`);
    const expected = beforeIds.filter((item) => item !== id).sort();
    if (afterIds.includes(id) || JSON.stringify([...afterIds].sort()) !== JSON.stringify(expected)) {
      fail(EXIT.normalize, `could not verify that only label ID "${id}" was deleted in repository "${targetRepo}"`);
    }
    emit({ provider: "forgejo", repository: targetRepo, operation, label_id: id, success: true });
    return;
  }
  if (operation === "label.create") {
    const parsed = parseOptions(args, { name: "value", color: "value", description: "value" });
    requireValue(parsed.name, "--name");
    const color = String(parsed.color || "808080").replace(/^#/, "");
    if (!/^[0-9a-fA-F]{6}$/.test(color)) {
      fail(EXIT.usage, `--color must be a six-digit hexadecimal RGB value (for example 808080 or #808080); received "${parsed.color}"`);
    }
    const name = requireValue(parsed.name, "--name");
    const native = ["labels", "create", "--name", name, ...labelScoped];
    native.push("--color", color.toUpperCase());
    if (parsed.description)
      native.push("--description", parsed.description);
    const result = run("tea", native);
    let visible = false;
    for (let page = 1;page <= MAX_LABEL_PAGES; page += 1) {
      const items = listForgejoLabels(labelScoped, LABEL_PAGE_SIZE, page, "label.create verification");
      if (items.some((item) => item.name === name)) {
        visible = true;
        break;
      }
      if (items.length < LABEL_PAGE_SIZE)
        break;
    }
    if (!visible) {
      fail(EXIT.normalize, `tea reported success, but label "${parsed.name}" was not visible in repository "${repo ?? "the detected repository"}" after creation; run sc label list to inspect the target repository and retry only if the label is absent`);
    }
    emit({ provider: "forgejo", operation, repository: repo, name: parsed.name, success: true, output: result.stdout.trim() });
    return;
  }
  if (operation === "auth.status") {
    const result = run("tea", ["whoami"], { allowFailure: true });
    emit({ provider: "forgejo", operation, repository: repo, authenticated: result.status === 0, tool: toolVersionInfo("tea") });
    return;
  }
  if (operation === "repo.view") {
    if (!repo)
      fail(EXIT.detection, "repository could not be determined; pass --repo OWNER/NAME");
    const [owner, name] = repo.split("/");
    const item = listForgejoRepository(owner, name, operation);
    if (!item)
      fail(EXIT.normalize, `repository not found in structured tea search output: ${repo}`);
    let visibility = null;
    if (typeof item.private === "boolean") {
      visibility = item.private ? "private" : "public";
    } else {
      const privateMatch = findForgejoRepository(owner, name, true, operation);
      const publicMatch = findForgejoRepository(owner, name, false, operation);
      if (Boolean(privateMatch) !== Boolean(publicMatch))
        visibility = privateMatch ? "private" : "public";
    }
    emit({ provider: "forgejo", operation, repository: repo, item: {
      name: `${scalar(item.owner, owner)}/${item.name ?? name}`,
      description: item.description ?? null,
      url: item.url ?? null,
      visibility,
      fork: typeof item.type === "string" && item.type.toLowerCase() === "fork",
      defaultBranch: item.default_branch ?? item.defaultBranch ?? null
    } });
    return;
  }
  if (operation === "issue.list" || operation === "pr.list") {
    const state = operation === "issue.list" ? parseOptions(args, { state: "value", label: "many" }).state : parseOptions(args, { state: "value" }).state;
    const labels2 = operation === "issue.list" ? parseOptions(args, { state: "value", label: "many" }).label : [];
    const entity = operation.startsWith("issue") ? "issues" : "pulls";
    const fields = operation.startsWith("issue") ? "index,title,body,state,author,url,labels,created,updated" : "index,title,body,state,author,url,labels,created,updated,base,head,mergeable,draft,ci";
    const native = [
      entity,
      "list",
      "--limit",
      String(options.limit),
      "--state",
      state || "open",
      "--fields",
      fields,
      "--output",
      "json",
      ...scoped
    ];
    if (labels2.length)
      native.push("--labels", labels2.join(","));
    const output = operation === "pr.list" ? runForgejoPullList(native) : run("tea", native).stdout;
    const data = parseJsonRecords(output, operation);
    emit({ provider: "forgejo", operation, repository: repo, items: data.map(normalizePullRequest) });
    return;
  }
  if (["issue.view", "pr.view"].includes(operation)) {
    const number = requireValue(args[0], `${operation.split(".")[0]} number`);
    const entity = operation.startsWith("issue") ? "issues" : "pulls";
    const fields = entity === "issues" ? "index,title,body,state,author,url,labels,created,updated" : "index,title,body,state,author,url,labels,created,updated,base,head,mergeable,draft";
    const data = parseJson(run("tea", [entity, number, "--fields", fields, "--output", "json", ...scoped]).stdout, operation);
    const item = requireJsonRecord(Array.isArray(data) ? data[0] : data, operation);
    emit({ provider: "forgejo", operation, repository: repo, item: entity === "pulls" ? normalizePullRequest(item) : normalizeItem(item) });
    return;
  }
  if (operation === "issue.comments" || operation === "pr.comments") {
    const number = requireValue(args[0], `${operation.split(".")[0]} number`);
    const data = operation === "pr.comments" ? parseForgejoCommentPages(number, scoped, operation) : parseCommentList(run("tea", ["comments", "list", number, "--output", "json", ...scoped]).stdout, operation);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), items: data.map(normalizeComment) });
    return;
  }
  if (operation === "issue.create") {
    const parsed = parseOptions(args, { title: "value", "body-file": "value", label: "many" });
    requireValue(parsed.title, "--title");
    const body = requireFile(parsed["body-file"], "--body-file");
    const native = ["issues", "create", "--title", parsed.title, "--description", body, ...scoped];
    if (parsed.label.length)
      native.push("--labels", parsed.label.join(","));
    const result = run("tea", native);
    emit(normalizeForgejoCreatedIssue(result.stdout, repo, parsed.title, scoped));
    return;
  }
  if (operation === "issue.edit") {
    const parsed = parseOptions(args, { "body-file": "value", "add-label": "many", "remove-label": "many" });
    const number = requireValue(parsed._[0], "issue number");
    const native = ["issues", "edit", number, ...scoped];
    if (parsed["body-file"]) {
      const body = requireFile(parsed["body-file"], "--body-file");
      native.push("--description", body);
    }
    if (parsed["add-label"].length)
      native.push("--add-labels", parsed["add-label"].join(","));
    if (parsed["remove-label"].length)
      native.push("--remove-labels", parsed["remove-label"].join(","));
    if (!parsed["body-file"] && !parsed["add-label"].length && !parsed["remove-label"].length) {
      fail(EXIT.usage, "issue edit requires --body-file, --add-label, or --remove-label");
    }
    if (parsed["add-label"].length || parsed["remove-label"].length) {
      const targetRepo = requireRepository(repo);
      resolveUniqueNames(listAllLabels("forgejo", targetRepo), [...parsed["add-label"], ...parsed["remove-label"]], targetRepo);
      resolveUniqueNames(listAllLabels("forgejo", targetRepo), [...parsed["add-label"], ...parsed["remove-label"]], targetRepo);
      if (!options.repo)
        native.push(...mutationRepoArgs(targetRepo));
    }
    const result = run("tea", native);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.remove-label") {
    const parsed = parseOptions(args, { id: "value" });
    const number = requireValue(parsed._[0], "issue number");
    if (!/^\d+$/.test(number) || Number(number) < 1)
      fail(EXIT.usage, `invalid issue number "${number}"`);
    const id = requireValue(parsed.id, "--id");
    validateLabelId("forgejo", id);
    const targetRepo = requireRepository(repo);
    const allLabels = listAllLabels("forgejo", targetRepo);
    const label = findLabelById(allLabels, id, targetRepo);
    const name = requireUniqueLabelName(allLabels, label, targetRepo);
    const before = readIssue("forgejo", number, targetRepo).labels;
    if (!before.some((item) => String(item.id) === id))
      fail(EXIT.missing, `label ID "${id}" is not attached to issue ${number} in repository "${targetRepo}"`);
    const current = listAllLabels("forgejo", targetRepo);
    const currentLabel = findLabelById(current, id, targetRepo);
    const currentName = requireUniqueLabelName(current, currentLabel, targetRepo);
    if (currentName !== name)
      fail(EXIT.normalize, `label ID "${id}" changed identity before removal in repository "${targetRepo}"`);
    run("tea", ["issues", "edit", number, "--remove-labels", currentName, ...mutationRepoArgs(targetRepo)]);
    const afterLabels = listAllLabels("forgejo", targetRepo);
    const afterTarget = findLabelById(afterLabels, id, targetRepo);
    if (requireUniqueLabelName(afterLabels, afterTarget, targetRepo) !== name) {
      fail(EXIT.normalize, `label ID "${id}" no longer uniquely maps to name "${name}" after issue removal in repository "${targetRepo}"`);
    }
    const after = readIssue("forgejo", number, targetRepo).labels;
    const beforeIds = before.map((item) => String(item.id ?? ""));
    const afterIds = after.map((item) => String(item.id ?? ""));
    const expected = beforeIds.filter((item) => item !== id).sort();
    if (beforeIds.some((item) => !item) || afterIds.some((item) => !item) || afterIds.includes(id) || JSON.stringify([...afterIds].sort()) !== JSON.stringify(expected)) {
      fail(EXIT.normalize, `could not verify that only label ID "${id}" was removed from issue ${number} in repository "${targetRepo}"`);
    }
    emit({ provider: "forgejo", repository: targetRepo, operation, issue_number: Number(number), label_id: id, success: true });
    return;
  }
  if (operation === "pr.edit") {
    const parsed = parseOptions(args, { "body-file": "value" });
    const number = requireValue(parsed._[0], "pull request number");
    const body = requireFile(parsed["body-file"], "--body-file");
    const result = run("tea", ["pulls", "edit", number, "--description", body, ...scoped]);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.close") {
    const number = requireValue(args[0], "issue number");
    const result = run("tea", ["issues", "close", number, ...scoped]);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "issue.comment" || operation === "pr.comment") {
    const parsed = parseOptions(args, { "body-file": "value" });
    const number = requireValue(parsed._[0], `${operation.split(".")[0]} number`);
    const body = requireFile(parsed["body-file"], "--body-file");
    const result = run("tea", ["comments", "add", number, body, ...scoped]);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), success: true, url: urlFromOutput(result.stdout) });
    return;
  }
  if (operation === "pr.diff" || operation === "pr.checks") {
    const number = requireValue(args[0], "pull request number");
    const field = operation.endsWith("diff") ? "diff" : "ci";
    const data = parseJson(run("tea", ["pulls", number, "--fields", `index,${field}`, "--output", "json", ...scoped]).stdout, operation);
    const item = requireJsonRecord(Array.isArray(data) ? data[0] : data, operation);
    if (operation.endsWith("diff")) {
      emit({ provider: "forgejo", operation, repository: repo, number: Number(number), diff: item.diff ?? "" });
    } else {
      const rawChecks = Array.isArray(item.ci) ? item.ci : item.ci ? [item.ci] : [];
      const checks = rawChecks.map((check, index) => requireJsonRecord(check, `${operation} check ${index + 1}`));
      emit({ provider: "forgejo", operation, repository: repo, number: Number(number), items: checks.map((check) => ({
        name: check.name ?? check.context ?? null,
        state: check.state ?? check.status ?? null,
        url: check.url ?? check.target_url ?? null,
        workflow: check.workflow ?? null
      })) });
    }
    return;
  }
  if (operation === "pr.create") {
    const parsed = parseOptions(args, { base: "value", head: "value", title: "value", "body-file": "value", draft: "boolean", label: "many" });
    const base = requireValue(parsed.base, "--base");
    const sourceHead = requireValue(parsed.head, "--head");
    const title = requireValue(parsed.title, "--title");
    const body = requireFile(parsed["body-file"], "--body-file");
    const owner = repo?.split("/")[0];
    const head = owner && sourceHead.includes("/") && !sourceHead.includes(":") ? `${owner}:${sourceHead}` : sourceHead;
    const native = [
      "pulls",
      "create",
      "--base",
      base,
      "--head",
      head,
      "--title",
      title,
      "--description",
      body,
      ...scoped
    ];
    if (parsed.draft)
      native.push("--draft");
    if (parsed.label.length)
      native.push("--labels", parsed.label.join(","));
    const result = run("tea", native, { allowFailure: true });
    if (result.status !== 0) {
      if (result.stderr)
        process.stderr.write(sanitizeText(result.stderr));
      fail(EXIT.native, `tea command failed with exit code ${result.status ?? "unknown"} while creating PR from base "${base}" to head "${sourceHead}" in repository "${repo}"; native command: tea pulls create`);
    }
    emit(normalizeCreatedPullRequest(result.stdout, "forgejo", repo, parsed, hostFromRemote(remoteUrl(options.remote))));
    return;
  }
  if (operation === "pr.ready") {
    const number = requireValue(args[0], "pull request number");
    const result = run("tea", ["pulls", "edit", number, "--ready", ...scoped]);
    emit({
      provider: "forgejo",
      operation,
      repository: repo,
      number: Number(number),
      success: true,
      url: urlFromOutput(result.stdout) ?? canonicalPullRequestUrl(repo, Number(number), hostFromRemote(remoteUrl(options.remote)))
    });
    return;
  }
  if (operation === "pr.checkout") {
    const number = requireValue(args[0], "pull request number");
    run("tea", ["pulls", "checkout", number, ...scoped]);
    emit({ provider: "forgejo", operation, repository: repo, number: Number(number), success: true });
    return;
  }
  fail(EXIT.unsupported, `operation is unsupported for forgejo: ${operation}`);
}
var HELP = `Usage: sc [global options] <resource> <action> [arguments]

Global options:
  --provider auto|forgejo|github  Select or detect the provider
  --repo OWNER/NAME               Target a repository
  --remote NAME                   Git remote used for detection (default: origin)
  --limit N                       List limit from 1 to 100 (default: 30)

Resources:
  provider | capabilities | auth status | repo view | label list|create|delete
  issue list|view|comments|create|edit|remove-label|close|comment
  pr list|view|comments|edit|diff|checks|create|comment|ready|checkout

Options:
  -h, --help                      Show this help
  -v, --version                   Show version

Successful commands write one normalized JSON object to stdout. Diagnostics go to stderr.

Environment:
  SC_SKIP_VERSION_CHECK=1         Skip the minimum tea (${MIN_TEA_VERSION}) and gh (${MIN_GH_VERSION}) version check
`;
var commandLine = process.argv.slice(2);
if (commandLine.some((value) => value === "--help" || value === "-h")) {
  process.stdout.write(HELP);
  process.exit(0);
}
if (commandLine.some((value) => value === "--version" || value === "-v")) {
  process.stdout.write(`sc ${VERSION}
`);
  process.exit(0);
}
var { options, rest } = parseGlobal(commandLine);
var resource = rest[0];
if (!resource)
  fail(EXIT.usage, "a command is required");
var provider = detectProvider(options);
var repo = repository(options);
if (resource === "provider") {
  emit({ provider, operation: "provider", repository: repo, tool: toolVersionInfo(provider === "github" ? "gh" : "tea") });
  process.exit(0);
}
if (resource === "capabilities") {
  emit({
    provider,
    operation: "capabilities",
    repository: repo,
    tool: toolVersionInfo(provider === "github" ? "gh" : "tea"),
    capabilities: {
      "repo.view": true,
      "label.list": true,
      "label.create": true,
      "label.delete": true,
      "issue.list": true,
      "issue.view": true,
      "issue.comments": true,
      "issue.create": true,
      "issue.edit": true,
      "issue.remove-label": true,
      "pr.edit": true,
      "issue.close": true,
      "issue.comment": true,
      "pr.list": true,
      "pr.view": true,
      "pr.comments": true,
      "pr.diff": true,
      "pr.checks": true,
      "pr.create": true,
      "pr.comment": true,
      "pr.ready": true,
      "pr.checkout": true,
      "pr.merge": false,
      "review.resolve": false,
      "release.create": false
    }
  });
  process.exit(0);
}
var action = rest[1];
if (!action)
  fail(EXIT.usage, `an action is required for ${resource}`);
if (!["auth", "repo", "label", "issue", "pr"].includes(resource)) {
  fail(EXIT.unsupported, `unsupported resource: ${resource}`);
}
var operation = `${resource}.${action}`;
var operationArgs = rest.slice(2);
if (provider === "github")
  github(operation, operationArgs, options);
else
  forgejo(operation, operationArgs, options);
